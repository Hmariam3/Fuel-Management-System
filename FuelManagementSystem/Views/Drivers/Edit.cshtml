@model FuelManagementSystem.Models.Driver
@{
    ViewBag.Title = "Edit Driver Record";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    /* Reuse styles from Create.cshtml for consistency */
    .select2-container--bootstrap-5 .select2-selection {
        height: calc(2rem + 2px);
        padding: 0rem 0.3rem;
        border: 1px solid #ced4da !important;
        border-radius: 0.375rem;
        font-size: 0.95rem;
    }

    .select2-container--bootstrap-5 .select2-selection__rendered {
        line-height: 2.2rem !important;
    }

    .select2-container--bootstrap-5 .select2-selection__arrow {
        height: 100% !important;
        top: 0.5rem !important;
    }

    .select2-results__options {
        max-height: 200px !important;
        overflow-y: auto !important;
    }

    .select2-container--bootstrap-5 .select2-selection__clear {
        position: absolute;
        right: 2.2rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1rem;
        color: #6c757d;
        cursor: pointer;
        opacity: 0.7;
    }

        .select2-container--bootstrap-5 .select2-selection__clear:hover {
            color: #dc3545;
            opacity: 1;
        }
</style>
<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Edit Driver Record - ID @Model.DriverID</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Drivers")">Drivers</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Edit</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-md-12">
                    <!--begin::Form Card-->
                    <div class="card card-success card-outline mb-4">
                        <div class="card-header">
                            <div class="card-title">Driver Edit Form</div>
                        </div>
                        @using (Html.BeginForm("Edit", "Drivers", FormMethod.Post, new { enctype = "multipart/form-data", @class = "needs-validation", novalidate = true }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(model => model.DriverID)
                            <div class="card-body">
                                <!-- Driver Details -->
                                <h5 class="mb-3">Driver Details</h5>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label for="DriverName" class="form-label">Driver Name *</label>
                                        @Html.EditorFor(model => model.DriverName, new { htmlAttributes = new { @class = "form-control", required = true } })
                                        @Html.ValidationMessageFor(model => model.DriverName, "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="PhoneNumber" class="form-label">Phone Number *</label>
                                        @Html.EditorFor(model => model.PhoneNumber, new { htmlAttributes = new { @class = "form-control", type = "tel", required = true, pattern = "\\+?[0-9]{10,15}", title = "Phone number must be 10-15 digits, optionally starting with +." } })
                                        @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="LicenseNumber" class="form-label">License Number *</label>
                                        @Html.EditorFor(model => model.LicenseNumber, new { htmlAttributes = new { @class = "form-control", required = true, pattern = "[A-Za-z0-9\\-]{1,20}", title = "License number must be alphanumeric with dashes, up to 20 characters." } })
                                        @Html.ValidationMessageFor(model => model.LicenseNumber, "", new { @class = "invalid-feedback" })
                                    </div>
                                </div>
                                <!-- Existing Documents -->
                                <h5 class="mt-4 mb-3">Existing Documents</h5>
                                @if (ViewBag.Documents != null && ViewBag.Documents.Count > 0)
                                {
                                    <div class="row g-3">
                                        <div class="col-md-12">
                                            <table class="table table-bordered">
                                                <thead>
                                                    <tr>
                                                        <th>Document Type</th>
                                                        <th>File Name</th>
                                                        <th>File Size (KB)</th>
                                                        <th>Uploaded By</th>
                                                        <th>Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var doc in ViewBag.Documents)
                                                    {
                                                        <tr>
                                                            <td>@doc.DocumentType</td>
                                                            <td>@System.IO.Path.GetFileName(doc.FilePath)</td>
                                                            <td>@doc.FileSize</td>
                                                            <td>@doc.UploadedBy</td>
                                                            <td>
                                                                <a href="@Url.Action("DownloadFile", "Drivers", new { id = doc.DocumentID })" class="btn btn-sm btn-primary">Download</a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p>No documents uploaded for this bolo registration.</p>
                                }

                                <h5 class="mt-4 mb-3">Add New License Attachment</h5>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="inspectionDocument" class="form-label">License Attachment</label>
                                        <div class="input-group">
                                            <input type="file" name="licenseAttachment" id="licenseAttachment" class="form-control" accept=".pdf,.jpg,.png" />
                                            <label class="input-group-text" for="licenseAttachment">Upload</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
                                <button type="submit" class="btn btn-primary me-2">Save Changes</button>
                                <a href="@Url.Action("Index", "Drivers")" class="btn btn-secondary">Cancel</a>
                            </div>
                        }
                    </div>
                    <!--end::Form Card-->
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content-->
</main>

@section scripts {
    <!-- jQuery Validation -->
    <script>
        $(document).ready(function () {
            // Bootstrap 5 validation
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });

            // Client-side validation for PhoneNumber and LicenseNumber
            $('#PhoneNumber, #LicenseNumber').on('input', function () {
                const value = $(this).val();
                const pattern = $(this).attr('pattern');
                const regex = new RegExp('^' + pattern + '$');
                if (!regex.test(value)) {
                    $(this).addClass('is-invalid');
                    $(this).next('.invalid-feedback').remove();
                    $(this).after(`<div class="invalid-feedback">${$(this).attr('title')}</div>`);
                } else {
                    $(this).removeClass('is-invalid');
                    $(this).next('.invalid-feedback').remove();
                }
            });

            // File upload validation
            $('#licenseAttachment').on('change', function () {
                const file = this.files[0];
                if (file) {
                    const maxSize = 5 * 1024 * 1024; // 5MB
                    const validTypes = $(this).attr('accept').split(',');
                    if (file.size > maxSize) {
                        $(this).addClass('is-invalid');
                        $(this).next('.invalid-feedback').remove();
                        $(this).after('<div class="invalid-feedback">File size exceeds 5MB.</div>');
                    } else if (!validTypes.includes('.' + file.name.split('.').pop().toLowerCase())) {
                        $(this).addClass('is-invalid');
                        $(this).next('.invalid-feedback').remove();
                        $(this).after('<div class="invalid-feedback">Only PDF, JPG, or PNG files are allowed.</div>');
                    } else {
                        $(this).removeClass('is-invalid');
                        $(this).next('.invalid-feedback').remove();
                    }
                }
            });
        });
    </script>
}