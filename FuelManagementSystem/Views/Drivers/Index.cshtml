@model IEnumerable<FuelManagementSystem.Models.Driver>
@{
    ViewBag.Title = "Driver Records";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Driver Records</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Drivers</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card card-success card-outline mb-4">
                        <div class="card-header">
                            <h3 class="card-title">Driver List</h3>
                            <div class="card-tools">
                                <a href="@Url.Action("Create", "Drivers")" class="btn btn-primary btn-sm">Register New Driver</a>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="driversTable" class="table table-bordered table-striped" aria-label="Driver records">
                                    <thead>
                                        <tr>
                                            <th style="width: 10px">#</th>
                                            <th>Driver ID</th>
                                            <th>Driver Name</th>
                                            <th>Phone Number</th>
                                            <th>License Number</th>
                                            <th>Compliance Status</th>
                                            <th style="width: 120px">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.Any())
                                        {
                                            var index = 1;
                                            foreach (var item in Model)
                                            {
                                                var complianceStatus = item.CreatedAt.HasValue ? "Active" : "Inactive";
                                                <tr class="align-middle">
                                                    <td>@index</td>
                                                    <td>@item.DriverID</td>
                                                    <td>@(string.IsNullOrEmpty(item.DriverName) ? "N/A" : item.DriverName)</td>
                                                    <td>@(string.IsNullOrEmpty(item.PhoneNumber) ? "N/A" : item.PhoneNumber)</td>
                                                    <td>@(string.IsNullOrEmpty(item.LicenseNumber) ? "N/A" : item.LicenseNumber)</td>
                                                    <td>
                                                        <span class="@(complianceStatus == "Active" ? "badge bg-success" : "badge bg-danger")">
                                                            @complianceStatus
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <a href="@Url.Action("Details", "Drivers", new { id = item.DriverID })"
                                                           class="btn btn-sm btn-info text-white me-1" title="Details">
                                                            <i class="bi bi-eye"></i>
                                                        </a>

                                                        <a href="@Url.Action("Edit", "Drivers", new { id = item.DriverID })"
                                                           class="btn btn-sm btn-warning text-white me-1" title="Edit">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </a>

                                                        <a href="@Url.Action("Delete", "Drivers", new { id = item.DriverID })"
                                                           class="btn btn-sm btn-danger" title="Delete">
                                                            <i class="bi bi-trash"></i>
                                                        </a>

                                                    </td>
                                                </tr>
                                                index++;
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center">No driver records found.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content-->
</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#driversTable').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                lengthMenu: [5, 10, 25, 50, 100],
                pageLength: 10,
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search records...",
                    paginate: {
                        previous: "&laquo;",
                        next: "&raquo;"
                    }
                },
                columnDefs: [
                    { orderable: false, targets: [0, -1] }
                ],
                dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });
        });
    </script>
}