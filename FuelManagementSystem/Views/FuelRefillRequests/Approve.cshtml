@model FuelManagementSystem.Models.FuelRefillRequest

@{
    ViewBag.Title = "Approve Fuel Refill Request";
}

<h2>Approve Fuel Refill Request</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
}

<div class="row">
    <div class="col-md-6">
        <h4>Request Details</h4>
        <dl class="dl-horizontal">
            <dt>Request ID</dt>
            <dd>@Model.RequestID</dd>
            <dt>Plate Number</dt>
            <dd>@Model.Vehicle.PlateNo</dd>
            <dt>Driver</dt>
            <dd>@Model.Driver.DriverName</dd>
            <dt>Current Odometer</dt>
            <dd>@Model.CurrentOdometer km</dd>
            <dt>Request Date</dt>
            <dd>@Model.RequestDateTime</dd>
            <dt>Status</dt>
            <dd>@Model.Status</dd>
            <dt>Mileage Deviation</dt>
            <dd>@Model.MileageDeviation%</dd>
        </dl>
    </div>
    <div class="col-md-6">
        <h4>Documents</h4>
        @if (!string.IsNullOrEmpty(Model.OdometerPhoto))
        {
            <p><strong>Odometer Photo:</strong> <a href="@Model.OdometerPhoto" target="_blank">View</a></p>
        }
        @if (!string.IsNullOrEmpty(Model.ReceiptImage))
        {
            <p><strong>Receipt Image:</strong> <a href="@Model.ReceiptImage" target="_blank">View</a></p>
        }
        @if (!string.IsNullOrEmpty(Model.DigitalSignature))
        {
            <p><strong>Digital Signature:</strong> <a href="@Model.DigitalSignature" target="_blank">View</a></p>
        }
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Approval Details</h4>
        <hr />
        <div class="form-group">
            @*@Html.LabelFor(model => model.LitersUsed, htmlAttributes: new { @class = "control-label col-md-2" })*@
            <div class="col-md-10">
                @*@Html.EditorFor(model => model.LitersUsed, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter liters used (optional)" } })
                @Html.ValidationMessageFor(model => model.LitersUsed, "", new { @class = "text-danger" })
                <input text/>*@
                <p class="text-muted">Leave blank to use the latest recorded quantity from the API (default 50L if none).</p>
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Approve" class="btn btn-primary" />
                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default" })
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}