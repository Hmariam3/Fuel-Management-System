@model FuelManagementSystem.Models.FuelRefillRequest

@{
    ViewBag.Title = "Fuel Refill Request Details - ID " + Model?.RequestID;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Fuel Refill Request Details - ID @Model.RequestID</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "FuelRefillRequests")">Fuel Refill Requests</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Details</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-md-12">
                    @if (Model == null)
                    {
                        <div class="card card-success card-outline mb-4">
                            <div class="card-body">
                                <div class="alert alert-danger">
                                    <p>Error: Fuel refill request record not found.</p>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        try
                        {
                            <!-- Request Details -->
                            <div class="card card-success card-outline mb-4">
                                <div class="card-header">
                                    <div class="card-title">Request Information</div>
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <strong class="form-label">Request ID</strong>
                                            <p>@Model.RequestID</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Vehicle</strong>
                                            <p>@(Model.Vehicle?.MakeAndType ?? "N/A") (@(string.IsNullOrEmpty(Model.PlateNo) ? "N/A" : Model.PlateNo))</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Driver</strong>
                                            <p>@(Model.Driver?.DriverName ?? "N/A")</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Odometer (km)</strong>
                                            <p>@(Model.CurrentOdometer.ToString() ?? "N/A")</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Request Date</strong>
                                            <p>@(Model.RequestDateTime.ToString("yyyy-MM-dd HH:mm:ss"))</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Status</strong>
                                            <p>@(string.IsNullOrEmpty(Model.Status) ? "N/A" : Model.Status)</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Mileage Deviation (%)</strong>
                                            <p>@(Model.MileageDeviation.HasValue ? Model.MileageDeviation.Value.ToString("N2") : "N/A")</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Review Status</strong>
                                            <p>@(string.IsNullOrEmpty(Model.ReviewStatus) ? "N/A" : Model.ReviewStatus)</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Liters Bought</strong>
                                            <p>@(Model.LittersBought.HasValue ? Model.LittersBought.Value.ToString("N2") : "N/A")</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Amount Paid</strong>
                                            <p>@(Model.AmountPaid.HasValue ? Model.AmountPaid.Value.ToString("N2") : "N/A")</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Unit Price</strong>
                                            <p>@(Model.UnitPrice.HasValue ? Model.UnitPrice.Value.ToString("N2") : "N/A")</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Location</strong>
                                            <p>@(string.IsNullOrEmpty(Model.Location) ? "N/A" : Model.Location)</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Receipt Number</strong>
                                            <p>@(Model.ReceiptNum.HasValue ? Model.ReceiptNum.Value.ToString() : "N/A")</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Is Early Refill</strong>
                                            <p>@(Model.IsEarlyRefill.HasValue ? (Model.IsEarlyRefill.Value ? "Yes" : "No") : "N/A")</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Odometer Photo</strong>
                                            <p><a href="@Model.OdometerPhoto" target="_blank">View Photo</a></p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Receipt Image</strong>
                                            <p><a href="@Model.ReceiptImage" target="_blank">View Receipt</a></p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Digital Signature</strong>
                                            <p><a href="@Model.DigitalSignature" target="_blank">View DigitalSignature</a></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Fuel Transactions -->
                            <div class="card card-success card-outline mb-4">
                                <div class="card-header">
                                    <div class="card-title">Related Fuel Transactions</div>
                                </div>
                                <div class="card-body">
                                    @if (Model.FuelTransactions != null && Model.FuelTransactions.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-bordered table-striped" aria-label="Fuel transactions">
                                                <thead>
                                                    <tr>
                                                        <th>Transaction ID</th>
                                                        <th>Liters Used (L)</th>
                                                        <th>Amount</th>
                                                        <th>Transaction Date</th>
                                                        <th>Location</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var transaction in Model.FuelTransactions)
                                                    {
                                                        <tr>
                                                            <td>@transaction.TransactionID</td>
                                                            <td>@transaction.LitersUsed</td>
                                                            <td>@transaction.Amount</td>
                                                            <td>@transaction.TransactionDateTime</td>
                                                            <td>@transaction.Location</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">No fuel transactions for this request.</p>
                                    }
                                </div>
                            </div>
                        }
                        catch (Exception ex)
                        {
                            <div class="card card-success card-outline mb-4">
                                <div class="card-body">
                                    <div class="alert alert-danger">
                                        <p>Error rendering fuel refill request details: @ex.Message</p>
                                    </div>
                                </div>
                            </div>
                            <script>
                                console.error('View rendering error:', '@ex.Message', '@ex.StackTrace');
                            </script>
                        }
                        <!-- Back Button -->
                        <div class="card card-success card-outline mb-4">
                            <div class="card-body">
                                <div class="d-flex justify-content-end">
                                    <a href="@Url.Action("Index", "FuelRefillRequests")" class="btn btn-primary">Back to List</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content-->
</main>