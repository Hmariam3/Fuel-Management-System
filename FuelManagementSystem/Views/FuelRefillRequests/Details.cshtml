@model FuelManagementSystem.Models.FuelRefillRequest
@{
    ViewBag.Title = "Fuel Refill Request Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Fuel Refill Request Details</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "FuelRefillRequests")">Fuel Refill Requests</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Details</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-md-12">
                    <!--begin::Details Card-->
                    <div class="card card-info card-outline mb-4">
                        <div class="card-header">
                            <div class="card-title">Request Information</div>
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-4">Request ID</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.RequestID)</dd>
                                <dt class="col-sm-4">Vehicle</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Vehicle.MakeAndType) (@Html.DisplayFor(model => model.PlateNo))</dd>
                                <dt class="col-sm-4">Driver</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Driver.DriverName)</dd>
                                <dt class="col-sm-4">Odometer (km)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.CurrentOdometer)</dd>
                                <dt class="col-sm-4">Request Date</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.RequestDateTime)</dd>
                                <dt class="col-sm-4">Status</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Status)</dd>
                                <dt class="col-sm-4">Digital Signature</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.DigitalSignature)</dd>
                                <dt class="col-sm-4">Mileage Deviation (%)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.MileageDeviation)</dd>
                                <dt class="col-sm-4">Odometer Photo</dt>
                                <dd class="col-sm-8"><a href="@Model.OdometerPhoto" target="_blank">View Photo</a></dd>
                                <dt class="col-sm-4">Receipt Image</dt>
                                <dd class="col-sm-8"><a href="@Model.ReceiptImage" target="_blank">View Receipt</a></dd>
                            </dl>
                        </div>
                        <div class="card-footer">
                            <a href="@Url.Action("Edit", "FuelRefillRequests", new { id = Model.RequestID })" class="btn btn-warning me-2">Edit</a>
                            <a href="@Url.Action("Index", "FuelRefillRequests")" class="btn btn-secondary">Back to List</a>
                        </div>
                    </div>
                    <!--end::Details Card-->
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content-->
</main>