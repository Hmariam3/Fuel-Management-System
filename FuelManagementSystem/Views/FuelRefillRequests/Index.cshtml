@model IEnumerable<FuelManagementSystem.Models.FuelRefillRequest>

@{
    ViewBag.Title = "Fuel Refill Request Records";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Fuel Refill Request Records</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Fuel Refill Requests</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card card-success card-outline mb-4">
                        <div class="card-header">
                            <h3 class="card-title">Fuel Refill Request List</h3>
                            <div class="card-tools">
                                <a href="@Url.Action("Create", "FuelRefillRequests")" class="btn btn-primary btn-sm">Register New Request</a>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="fuelRefillRequestsTable" class="table table-bordered table-striped" aria-label="Fuel Refill Request records">
                                    <thead>
                                        <tr>
                                            <th style="width: 10px">#</th>
                                            <th>Request ID</th>
                                            <th>Vehicle</th>
                                            <th>Driver</th>
                                            <th>Odometer (km)</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.Any())
                                        {
                                            var index = 1;
                                            foreach (var item in Model)
                                            {
                                                <tr class="align-middle">
                                                    <td>@index</td>
                                                    <td>@item.RequestID</td>
                                                    <td>@(item.Vehicle?.MakeAndType ?? "N/A") (@(string.IsNullOrEmpty(item.PlateNo) ? "N/A" : item.PlateNo))</td>
                                                    <td>@(item.Driver?.DriverName ?? "N/A")</td>
                                                    <td>@(item.CurrentOdometer.ToString() ?? "N/A")</td>
                                                    <td>@(string.IsNullOrEmpty(item.Status) ? "N/A" : item.Status)</td>
                                                    <td>
                                                        <a href="@Url.Action("Details", new { id = item.RequestID })"
                                                           class="btn btn-sm btn-info text-white me-1" title="Details">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                        <a href="@Url.Action("Edit", new { id = item.RequestID })"
                                                           class="btn btn-sm btn-warning text-white me-1" title="Edit">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </a>
                                                        <a href="@Url.Action("Delete", new { id = item.RequestID })"
                                                           class="btn btn-sm btn-danger" title="Delete">
                                                            <i class="bi bi-trash"></i>
                                                        </a>
                                                        @if (item.Status == "Pending")
                                                        {
                                                            <a href="@Url.Action("Approve", new { id = item.RequestID })"
                                                               class="btn btn-sm btn-primary" title="Authorize">
                                                                <i class="bi bi-check-circle"></i>
                                                            </a>
                                                        }
                                                        </td>
                                                </tr>
                                                index++;
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="8" class="text-center">No fuel refill request records found.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content-->
</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#fuelRefillRequestsTable').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                lengthMenu: [5, 10, 25, 50, 100],
                pageLength: 10,
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search records...",
                    paginate: {
                        previous: "&laquo;",
                        next: "&raquo;"
                    }
                },
                columnDefs: [
                    { orderable: false, targets: [0, -1] }
                ],
                dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });
        });
    </script>
}