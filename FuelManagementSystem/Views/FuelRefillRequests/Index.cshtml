@model IEnumerable<FuelManagementSystem.Models.FuelRefillRequest>
@{
    ViewBag.Title = "Fuel Refill Request List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Fuel Refill Request List</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Fuel Refill Requests</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-md-12">
                    <!--begin::Table Card-->
                    <div class="card card-primary card-outline mb-4">
                        <div class="card-header">
                            <div class="card-title">All Fuel Refill Requests</div>
                            <div class="card-tools">
                                <a href="@Url.Action("Create", "FuelRefillRequests")" class="btn btn-sm btn-success">Create New Request</a>
                            </div>
                        </div>
                        <div class="card-body">
                            <table class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th>Request ID</th>
                                        <th>Vehicle</th>
                                        <th>Driver</th>
                                        <th>Odometer (km)</th>
                                        <th>Status</th>
                                        <th>Digital Signature</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@Html.DisplayFor(modelItem => item.RequestID)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Vehicle.MakeAndType) (@Html.DisplayFor(modelItem => item.PlateNo))</td>
                                            <td>@Html.DisplayFor(modelItem => item.Driver.DriverName)</td>
                                            <td>@Html.DisplayFor(modelItem => item.CurrentOdometer)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Status)</td>
                                            <td>@Html.DisplayFor(modelItem => item.DigitalSignature)</td>
                                            <td>
                                                <a href="@Url.Action("Details", new { id = item.RequestID })" class="btn btn-sm btn-info">Details</a>
                                                <a href="@Url.Action("Edit", new { id = item.RequestID })" class="btn btn-sm btn-warning">Edit</a>
                                                <a href="@Url.Action("Delete", new { id = item.RequestID })" class="btn btn-sm btn-danger">Delete</a>
                                                <a href="@Url.Action("Approve", new { id = item.RequestID })" class="btn btn-sm btn-primary">Authorize</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!--end::Table Card-->
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content-->
</main>

@section scripts {
    <script>
        $(document).ready(function () {
            $('.table').DataTable({
                "paging": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true
            });
        });
    </script>
}