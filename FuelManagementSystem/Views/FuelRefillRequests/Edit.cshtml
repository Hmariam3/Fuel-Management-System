@model FuelManagementSystem.Models.FuelRefillRequest
@{
    ViewBag.Title = "Edit Fuel Refill Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .select2-container--bootstrap-5 .select2-selection {
        height: calc(2rem + 2px);
        padding: 0rem 0.3rem;
        border: 1px solid #ced4da !important;
        border-radius: 0.375rem;
        font-size: 0.95rem;
    }

    .select2-container--bootstrap-5 .select2-selection__rendered {
        line-height: 2.2rem !important;
    }

    .select2-container--bootstrap-5 .select2-selection__arrow {
        height: 100% !important;
        top: 0.5rem !important;
    }

    .select2-results__options {
        max-height: 200px !important;
        overflow-y: auto !important;
    }

    .select2-container--bootstrap-5 .select2-selection__clear {
        position: absolute;
        right: 2.2rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1rem;
        color: #6c757d;
        cursor: pointer;
        opacity: 0.7;
    }

        .select2-container--bootstrap-5 .select2-selection__clear:hover {
            color: #dc3545;
            opacity: 1;
        }
</style>

<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Edit Fuel Refill Request</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "FuelRefillRequests")">Fuel Refill Requests</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Edit</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-md-12">
                    <!--begin::Form Card-->
                    <div class="card card-warning card-outline mb-4">
                        <div class="card-header">
                            <div class="card-title">Edit Fuel Refill Request Form</div>
                        </div>
                        @using (Html.BeginForm("Edit", "FuelRefillRequests", FormMethod.Post, new { @class = "needs-validation", novalidate = true, enctype = "multipart/form-data" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(model => model.RequestID)
                            @Html.HiddenFor(model => model.RequestDateTime)
                            @Html.HiddenFor(model => model.MileageDeviation)
                            <div class="card-body">
                                <h5 class="mb-3">Request Details</h5>
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label for="PlateNo" class="form-label">Vehicle *</label>
                                        @Html.DropDownListFor(model => model.PlateNo, ViewBag.PlateNo as SelectList, "Select Vehicle", new { @class = "form-select select2", data_placeholder = "Select Vehicle", required = true })
                                        @Html.ValidationMessageFor(model => model.PlateNo, "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="DriverID" class="form-label">Driver *</label>
                                        @Html.DropDownListFor(model => model.DriverID, ViewBag.DriverID as SelectList, "Select Driver", new { @class = "form-select select2", data_placeholder = "Select Driver", required = true })
                                        @Html.ValidationMessageFor(model => model.DriverID, "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="CurrentOdometer" class="form-label">Current Odometer (km) *</label>
                                        @Html.EditorFor(model => model.CurrentOdometer, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", required = true } })
                                        @Html.ValidationMessageFor(model => model.CurrentOdometer, "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="LitersUsed" class="form-label">Liters Used *</label>
                                        <input type="number" name="litersUsed" class="form-control" id="LitersUsed" step="0.01" min="0.01" value="@(db.FuelTransactions.FirstOrDefault(t => t.RequestID == Model.RequestID)?.LitersUsed)" required />
                                        <div id="litersUsedHelp" class="form-text">Enter the amount of fuel used (liters).</div>
                                        @Html.ValidationMessage("litersUsed", "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="DigitalSignature" class="form-label">Digital Signature *</label>
                                        @Html.DropDownListFor(model => model.DigitalSignature,
                                            new SelectList(new[]
                                            {
                                                new { Value = "Pending", Text = "Pending" },
                                                new { Value = "Approved", Text = "Approved" }
                                            }, "Value", "Text", Model.DigitalSignature),
                                            "Select Signature Status",
                                            new { @class = "form-select select2", data_placeholder = "Select Signature Status", required = true })
                                        @Html.ValidationMessageFor(model => model.DigitalSignature, "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="Status" class="form-label">Status *</label>
                                        @Html.DropDownListFor(model => model.Status,
                                            new SelectList(new[]
                                            {
                                                new { Value = "Pending", Text = "Pending" },
                                                new { Value = "PendingReview", Text = "Pending Review" },
                                                new { Value = "Approved", Text = "Approved" },
                                                new { Value = "Rejected", Text = "Rejected" }
                                            }, "Value", "Text", Model.Status),
                                            "Select Status",
                                            new { @class = "form-select select2", data_placeholder = "Select Status", required = true })
                                        @Html.ValidationMessageFor(model => model.Status, "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="odometerPhoto" class="form-label">Odometer Photo (Current: @Model.OdometerPhoto)</label>
                                        <div class="input-group">
                                            <input type="file" name="odometerPhoto" class="form-control" id="odometerPhoto" accept=".jpg,.jpeg,.png" />
                                            <label class="input-group-text" for="odometerPhoto">Upload</label>
                                        </div>
                                        <div id="odometerPhotoHelp" class="form-text">Upload new odometer photo (JPG/PNG) if needed.</div>
                                        @Html.ValidationMessage("odometerPhoto", "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="receiptImage" class="form-label">Receipt Image (Current: @Model.ReceiptImage)</label>
                                        <div class="input-group">
                                            <input type="file" name="receiptImage" class="form-control" id="receiptImage" accept=".jpg,.jpeg,.png" />
                                            <label class="input-group-text" for="receiptImage">Upload</label>
                                        </div>
                                        <div id="receiptImageHelp" class="form-text">Upload new receipt image (JPG/PNG) if needed.</div>
                                        @Html.ValidationMessage("receiptImage", "", new { @class = "invalid-feedback" })
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
                                <button type="submit" class="btn btn-primary me-2">Save</button>
                                <a href="@Url.Action("Index", "FuelRefillRequests")" class="btn btn-secondary">Cancel</a>
                            </div>
                        }
                    </div>
                    <!--end::Form Card-->
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content-->
</main>

@section scripts {
    <script src="~/plugins/select2/js/select2.full.min.js"></script>
    <script>
        $(document).ready(function () {
            // Initialize Select2
            $('.select2').select2({
                theme: 'bootstrap-5',
                placeholder: $(this).data('placeholder') || 'Select an option',
                allowClear: true,
                width: '100%'
            });

            // Bootstrap 5 validation
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                    $('.select2').each(function () {
                        $(this).valid();
                    });
                }, false);
            });

            // Integrate jQuery validation with Select2
            $('.select2').on('select2:select select2:clear', function () {
                $(this).valid();
            });

            // Ensure Select2 borders are updated
            $('.select2').on('select2:open', function () {
                $(this).next('.select2-container').find('.select2-selection--single').addClass('form-select');
            });

            // Client-side validation for CurrentOdometer
            $('#CurrentOdometer').on('input', function () {
                const value = parseInt($(this).val());
                if (isNaN(value) || value <= 0) {
                    $(this).addClass('is-invalid');
                    $(this).next('.invalid-feedback').remove();
                    $(this).after('<div class="invalid-feedback">Odometer reading must be a positive number.</div>');
                } else {
                    $(this).removeClass('is-invalid');
                    $(this).next('.invalid-feedback').remove();
                }
            });

            // Client-side validation for LitersUsed
            $('#LitersUsed').on('input', function () {
                const value = parseFloat($(this).val());
                if (isNaN(value) || value <= 0) {
                    $(this).addClass('is-invalid');
                    $(this).next('.invalid-feedback').remove();
                    $(this).after('<div class="invalid-feedback">Liters used must be a positive number.</div>');
                } else {
                    $(this).removeClass('is-invalid');
                    $(this).next('.invalid-feedback').remove();
                }
            });

            // Client-side validation for file uploads
            $('#odometerPhoto, #receiptImage').on('change', function () {
                const file = this.files[0];
                if (file) {
                    const ext = file.name.split('.').pop().toLowerCase();
                    if (['jpg', 'jpeg', 'png'].indexOf(ext) === -1) {
                        $(this).addClass('is-invalid');
                        $(this).next('.invalid-feedback').remove();
                        $(this).after('<div class="invalid-feedback">Only JPG or PNG files are allowed.</div>');
                    } else {
                        $(this).removeClass('is-invalid');
                        $(this).next('.invalid-feedback').remove();
                    }
                }
            });
        });
    </script>
}