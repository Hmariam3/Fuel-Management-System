@model IEnumerable<FuelManagementSystem.Models.FuelTransaction>
@{
    ViewBag.Title = "Fuel Transactions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Fuel Transactions</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Transactions</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card card-success card-outline mb-4">
                        <div class="card-header">
                            <h3 class="card-title">Transaction List</h3>

                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="fuelTransactionsTable" class="table table-striped table-bordered" aria-label="Fuel transaction records">
                                    <thead>
                                        <tr>
                                            <th>T ID</th>
                                            <th>Plate No</th>
                                            <th>Driver</th>
                                            <th>Liters Used</th>
                                            <th>Amount</th>
                                            <th>Beg Km</th>
                                            <th>End Km</th>
                                            <th>D KM</th>
                                            <th>Avg Km/Liter</th>
                                            <th>Transaction Date</th>
                                            <th>Ecard Balance After</th>
                                            <th>Location</th>
                                            <th>Receipt Num</th>
                                            <th>Product</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.Any())
                                        {
                                            foreach (var item in Model)
                                            {
                                        <tr class="align-middle">
                                            <td>@item.TransactionID</td>
                                            <td>@(string.IsNullOrEmpty(item.FuelRefillRequest?.PlateNo) ? "N/A" : item.FuelRefillRequest.PlateNo)</td>
                                            <td>@(item.Driver?.DriverName ?? "N/A")</td>
                                            <td>@item.LitersUsed</td>
                                            <td>@item.Amount</td>
                                            <td>@item.BegKm</td>
                                            <td>@item.EndKm</td>
                                            <td>@item.D_KM</td>
                                            <td>@item.AvgKmLiter</td>
                                            <td>@item.TransactionDateTime</td>
                                            <td>@item.EcardBalanceAfter</td>
                                            <td>@(string.IsNullOrEmpty(item.Location) ? "N/A" : item.Location)</td>
                                            <td>@item.ReceiptNum</td>
                                            <td>@(string.IsNullOrEmpty(item.Product) ? "N/A" : item.Product)</td>
                                        </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="15" class="text-center">No fuel transaction records found.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content-->
</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#fuelTransactionsTable').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                lengthMenu: [5, 10, 25, 50, 100],
                pageLength: 10,
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search records...",
                    paginate: {
                        previous: "&laquo;",
                        next: "&raquo;"
                    }
                },
                columnDefs: [
                    { orderable: false, targets: [-1] }
                ],
                dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });
        });
    </script>
}