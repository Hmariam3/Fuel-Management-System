@model FuelManagementSystem.Models.Vehicle

@{
    ViewBag.Title = "Create Vehicle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .select2-container--bootstrap-5 .select2-selection {
        height: calc(2rem + 2px);
        padding: 0rem 0.3rem;
        border: 1px solid #ced4da !important;
        border-radius: 0.375rem;
        font-size: 0.95rem;
    }

    .select2-container--bootstrap-5 .select2-selection__rendered {
        line-height: 2.2rem !important;
    }

    .select2-container--bootstrap-5 .select2-selection__arrow {
        height: 100% !important;
        top: 0.5rem !important;
    }

    .select2-results__options {
        max-height: 200px !important;
        overflow-y: auto !important;
    }

    .select2-container--bootstrap-5 .select2-selection__clear {
        position: absolute;
        right: 2.2rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1rem;
        color: #6c757d;
        cursor: pointer;
        opacity: 0.7;
    }

        .select2-container--bootstrap-5 .select2-selection__clear:hover {
            color: #dc3545;
            opacity: 1;
        }
</style>

<main class="app-main">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Create Vehicle</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Vehicles")">Vehicles</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Create</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <div class="app-content">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-md-12">
                    <div class="card card-success card-outline mb-4">
                        <div class="card-header">
                            <div class="card-title">Vehicle Registration Form</div>
                        </div>
                        @using (Html.BeginForm("Create", "Vehicles", FormMethod.Post, new { @class = "needs-validation", novalidate = true }))
                        {
                            @Html.AntiForgeryToken()
                            <div class="card-body">
                                <h5 class="mb-3">Vehicle Details</h5>
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label for="PlateNo" class="form-label">Plate No *</label>
                                        @Html.EditorFor(model => model.PlateNo, new { htmlAttributes = new { @class = "form-control", required = true } })
                                        @Html.ValidationMessageFor(model => model.PlateNo, "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="VehicleType" class="form-label">Vehicle Type *</label>
                                        @Html.EditorFor(model => model.VehicleType, new { htmlAttributes = new { @class = "form-control", required = true } })
                                        @Html.ValidationMessageFor(model => model.VehicleType, "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="ChassisNo" class="form-label">Chassis No *</label>
                                        @Html.EditorFor(model => model.ChassisNo, new { htmlAttributes = new { @class = "form-control", required = true } })
                                        @Html.ValidationMessageFor(model => model.ChassisNo, "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="MakeAndType" class="form-label">Make and Type *</label>
                                        @Html.EditorFor(model => model.MakeAndType, new { htmlAttributes = new { @class = "form-control", required = true } })
                                        @Html.ValidationMessageFor(model => model.MakeAndType, "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="DriverID" class="form-label">Driver *</label>
                                        @Html.DropDownListFor(model => model.DriverID, ViewBag.DriverID as SelectList, "Select Driver", new { @class = "form-select select2", data_placeholder = "Select Driver", required = true })
                                        @Html.ValidationMessageFor(model => model.DriverID, "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="FuelTypeID" class="form-label">Fuel Type *</label>
                                        @Html.DropDownListFor(model => model.FuelTypeID, ViewBag.FuelTypeID as SelectList, "Select Fuel Type", new { @class = "form-select select2", data_placeholder = "Select Fuel Type", required = true })
                                        @Html.ValidationMessageFor(model => model.FuelTypeID, "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="UserOrgan" class="form-label">User Organ *</label>
                                        @Html.DropDownListFor(model => model.UserOrgan, ViewBag.UserOrgan as SelectList, "Select User Organ", new { @class = "form-select select2", required = true })
                                        @Html.ValidationMessageFor(model => model.UserOrgan, "", new { @class = "invalid-feedback" })
                                    </div>
                                    @*<div class="col-md-4">
                                        <label for="VehicleAssignmentType" class="form-label">Assignment Type *</label>
                                        @Html.DropDownListFor(model => model.VehicleAssignmentType, ViewBag.VehicleAssignmentType as SelectList, "Select Assignment Type", new { @class = "form-select select2", data_placeholder = "Select Assignment Type", required = true })
                                        @Html.ValidationMessageFor(model => model.VehicleAssignmentType, "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="CostCenterID" class="form-label">Cost Center *</label>
                                        @Html.DropDownListFor(model => model.CostCenterID, ViewBag.CostCenterID as SelectList, "Select Cost Center", new { @class = "form-select select2", data_placeholder = "Select Cost Center", required = true })
                                        @Html.ValidationMessageFor(model => model.CostCenterID, "", new { @class = "invalid-feedback" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="BranchID" class="form-label">Branch *</label>
                                        @Html.DropDownListFor(model => model.BranchID, ViewBag.BranchID as SelectList, "Select Branch", new { @class = "form-select select2", data_placeholder = "Select Branch", required = true })
                                        @Html.ValidationMessageFor(model => model.BranchID, "", new { @class = "invalid-feedback" })
                                    </div>*@
                                </div>
                            </div>
                            <div class="card-footer">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
                                <button type="submit" class="btn btn-primary me-2">Create</button>
                                <a href="@Url.Action("Index", "Vehicles")" class="btn btn-secondary">Cancel</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section scripts {
    <script src="~/plugins/select2/js/select2.full.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                theme: 'bootstrap-5',
                placeholder: $(this).data('placeholder') || 'Select an option',
                allowClear: true,
                width: '100%'
            });

            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                    $('.select2').each(function () {
                        $(this).valid();
                    });
                }, false);
            });

            $('.select2').on('select2:select select2:clear', function () {
                $(this).valid();
            });

            $('.select2').on('select2:open', function () {
                $(this).next('.select2-container').find('.select2-selection--single').addClass('form-select');
            });
        });
    </script>
}