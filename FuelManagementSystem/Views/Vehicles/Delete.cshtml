@model FuelManagementSystem.Models.Vehicle

@{
    ViewBag.Title = "Delete Vehicle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .select2-container--bootstrap-5 .select2-selection {
        height: calc(2rem + 2px);
        padding: 0rem 0.3rem;
        border: 1px solid #ced4da !important;
        border-radius: 0.375rem;
        font-size: 0.95rem;
    }

    .select2-container--bootstrap-5 .select2-selection__rendered {
        line-height: 2.2rem !important;
    }

    .select2-container--bootstrap-5 .select2-selection__arrow {
        height: 100% !important;
        top: 0.5rem !important;
    }

    .select2-results__options {
        max-height: 200px !important;
        overflow-y: auto !important;
    }

    .select2-container--bootstrap-5 .select2-selection__clear {
        position: absolute;
        right: 2.2rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1rem;
        color: #6c757d;
        cursor: pointer;
        opacity: 0.7;
    }

        .select2-container--bootstrap-5 .select2-selection__clear:hover {
            color: #dc3545;
            opacity: 1;
        }
</style>

<main class="app-main">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Delete Vehicle</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Vehicles")">Vehicles</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Delete</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <div class="app-content">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-md-12">
                    <div class="card card-danger card-outline mb-4">
                        <div class="card-header">
                            <div class="card-title">Confirm Delete</div>
                        </div>
                        <div class="card-body">
                            <h5 class="mb-3">Are you sure you want to delete this vehicle?</h5>
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <dl class="row">
                                <dt class="col-sm-3">Plate No</dt>
                                <dd class="col-sm-9">@Html.DisplayFor(model => model.PlateNo)</dd>
                                <dt class="col-sm-3">Vehicle Type</dt>
                                <dd class="col-sm-9">@Html.DisplayFor(model => model.VehicleType)</dd>
                                <dt class="col-sm-3">Chassis No</dt>
                                <dd class="col-sm-9">@Html.DisplayFor(model => model.ChassisNo)</dd>
                                <dt class="col-sm-3">Make and Type</dt>
                                <dd class="col-sm-9">@Html.DisplayFor(model => model.MakeAndType)</dd>
                                <dt class="col-sm-3">Driver</dt>
                                <dd class="col-sm-9">@Html.DisplayFor(model => model.Driver.DriverName)</dd>
                                <dt class="col-sm-3">Fuel Type</dt>
                                <dd class="col-sm-9">@Html.DisplayFor(model => model.FuelType.FuelTypeName)</dd>
                                <dt class="col-sm-3">Branch</dt>
                                <dd class="col-sm-9">@Html.DisplayFor(model => model.Branch.BranchName)</dd>
                            </dl>
                        </div>
                        <div class="card-footer">
                            @using (Html.BeginForm("DeleteConfirmed", "Vehicles", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(model => model.PlateNo)
                                <button type="submit" class="btn btn-danger me-2">Delete</button>
                                <a href="@Url.Action("Index", "Vehicles")" class="btn btn-secondary">Cancel</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>