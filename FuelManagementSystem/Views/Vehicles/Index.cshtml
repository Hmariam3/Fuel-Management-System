@model IEnumerable<FuelManagementSystem.Models.Vehicle>

@{
    ViewBag.Title = "Vehicle Records";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h3 class="mb-0">Vehicle Records</h3>
                </div>
                <div class="col-sm-6">
                    <div class="d-flex justify-content-end align-items-center gap-2">
                        <div class="input-group input-group-sm" style="width: 250px;">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" class="form-control border-start-0" placeholder="Search records..." aria-label="Search" id="searchInput">
                        </div>
                        <a href="@Url.Action("Create", "Vehicles")" class="btn btn-primary btn-sm">Register New Vehicle</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card card-outline card-success mb-4 shadow-sm">
                        <div class="card-body p-4">
                            <div class="table-responsive" style="max-height: 70vh; overflow-x: auto;">
                                <table id="vehiclesTable" class="table table-bordered table-striped table-hover" aria-label="Vehicle records">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 50px; font-weight: bold;">#</th>
                                            <th style="min-width: 100px; font-weight: bold;">Plate No</th>
                                            <th style="min-width: 150px; font-weight: bold;">Vehicle Type</th>
                                            <th style="min-width: 150px; font-weight: bold;">Chassis No</th>
                                            <th style="min-width: 200px; font-weight: bold;">Make and Type</th>
                                            <th style="min-width: 120px; font-weight: bold;">Driver</th>
                                            <th style="min-width: 120px; font-weight: bold;">Status</th>
                                            <th style="min-width: 150px; font-weight: bold; position: sticky; right: 0;  z-index: 1;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.Any())
                                        {
                                            var index = 1;
                                            foreach (var item in Model)
                                            {
                                                var complianceStatus = item.CreatedAt.HasValue ? "Active" : "Inactive";
                                                <tr class="align-middle">
                                                    <td>@index</td>
                                                    <td>@(string.IsNullOrEmpty(item.PlateNo) ? "N/A" : item.PlateNo)</td>
                                                    <td>@(string.IsNullOrEmpty(item.VehicleType) ? "N/A" : item.VehicleType)</td>
                                                    <td>@(string.IsNullOrEmpty(item.ChassisNo) ? "N/A" : item.ChassisNo)</td>
                                                    <td>@(string.IsNullOrEmpty(item.MakeAndType) ? "N/A" : item.MakeAndType)</td>
                                                    <td>@(item.Driver?.DriverName ?? "N/A")</td>
                                                    <td>
                                                        <span class="badge"
                                                              style="background-color: @(complianceStatus == "Active" ? "green" : "gray"); color: white; border-radius: 15px; padding: 5px 10px;">
                                                            @complianceStatus
                                                        </span>
                                                    </td>
                                                    <td style="position: sticky; right: 0; z-index: 1;">
                                                        <a href="@Url.Action("Details", "Vehicles", new { id = item.PlateNo })"
                                                           class="btn btn-sm btn-info text-white me-1" title="Details">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                        <a href="@Url.Action("Edit", "Vehicles", new { id = item.PlateNo })"
                                                           class="btn btn-sm btn-warning text-white me-1" title="Edit">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </a>
                                                        <a href="@Url.Action("Delete", "Vehicles", new { id = item.PlateNo })"
                                                           class="btn btn-sm btn-danger" title="Delete">
                                                            <i class="bi bi-trash"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                                index++;
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="8" class="text-center">No vehicle records found.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content-->
</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            const table = $('#vehiclesTable').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                lengthMenu: [5, 10, 25, 50],
                pageLength: 6,
                responsive: true,
                language: {
                    search: "",
                    searchPlaceholder: "Search records...",
                    paginate: {
                        previous: "&laquo;",
                        next: "&raquo;"
                    },
                    emptyTable: "No vehicle records found."
                },
                columnDefs: [
                    { orderable: false, targets: [0, -1] },
                    { width: "50px", targets: 0 },
                    { width: "100px", targets: 1 },
                    { width: "150px", targets: 2 },
                    { width: "150px", targets: 3 },
                    { width: "200px", targets: 4 },
                    { width: "120px", targets: 5 },
                    { width: "120px", targets: 6 },
                    { width: "150px", targets: 7 }
                ],
                dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                scrollX: true
            });

            // Custom search input binding
            $('#searchInput').on('keyup', function () {
                table.search(this.value).draw();
            });
        });
    </script>
}