@model IEnumerable<FuelManagementSystem.Models.Vehicle>

@{
    ViewBag.Title = "Vehicle Records";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Vehicle Records</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Vehicles</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card card-success card-outline mb-4">
                        <div class="card-header">
                            <h3 class="card-title">Vehicle List</h3>
                            <div class="card-tools">
                                <a href="@Url.Action("Create", "Vehicles")" class="btn btn-primary btn-sm">Register New Vehicle</a>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="vehiclesTable" class="table table-bordered table-striped" aria-label="Vehicle records">
                                    <thead>
                                        <tr>
                                            <th style="width: 10px">#</th>
                                            <th>Plate No</th>
                                            <th>Vehicle Type</th>
                                            <th>Chassis No</th>
                                            <th>Make and Type</th>
                                            <th>Driver</th>
                                            <th style="width: 120px">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.Any())
                                        {
                                            var index = 1;
                                            foreach (var item in Model)
                                            {
                                                var complianceStatus = item.CreatedAt.HasValue ? "Active" : "Inactive";
                                                <tr class="align-middle">
                                                    <td>@index</td>
                                                    <td>@item.PlateNo</td>
                                                    <td>@(string.IsNullOrEmpty(item.VehicleType) ? "N/A" : item.VehicleType)</td>
                                                    <td>@(string.IsNullOrEmpty(item.ChassisNo) ? "N/A" : item.ChassisNo)</td>
                                                    <td>@(string.IsNullOrEmpty(item.MakeAndType) ? "N/A" : item.MakeAndType)</td>
                                                    <td>@(item.Driver?.DriverName ?? "N/A")</td>
                                                    <td>
                                                        <a href="@Url.Action("Details", "Vehicles", new { id = item.PlateNo })"
                                                           class="btn btn-sm btn-info text-white me-1" title="Details">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                        <a href="@Url.Action("Edit", "Vehicles", new { id = item.PlateNo })"
                                                           class="btn btn-sm btn-warning text-white me-1" title="Edit">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </a>
                                                        <a href="@Url.Action("Delete", "Vehicles", new { id = item.PlateNo })"
                                                           class="btn btn-sm btn-danger" title="Delete">
                                                            <i class="bi bi-trash"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                                index++;
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center">No vehicle records found.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content-->
</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#vehiclesTable').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                lengthMenu: [5, 10, 25, 50, 100],
                pageLength: 10,
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search records...",
                    paginate: {
                        previous: "&laquo;",
                        next: "&raquo;"
                    }
                },
                columnDefs: [
                    { orderable: false, targets: [0, -1] }
                ],
                dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });
        });
    </script>
}