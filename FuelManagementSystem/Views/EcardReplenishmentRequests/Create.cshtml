@model FuelManagementSystem.Models.EcardReplenishmentRequest
@{
    ViewBag.Title = "Request E-Card Replenishment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Request E-Card Replenishment</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Ecards")">E-Cards</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Request Replenishment</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card card-success card-outline mb-4">
                        <div class="card-header">
                            <div class="card-title">Replenishment Request Form</div>
                        </div>
                        <div class="card-body">
                            @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "needs-validation", novalidate = "" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.EcardID, new { @class = "form-label" })
                                            @Html.DropDownList("EcardID", null, "Select Card", new { @class = "form-control", required = "required" })

                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.RequestedAmount, new { @class = "form-label" })
                                            @Html.TextBoxFor(m => m.RequestedAmount, new { @class = "form-control", type = "number", step = "0.01", min = "0", required = "required" })

                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Note, new { @class = "form-label" })
                                            @Html.TextAreaFor(m => m.Note, new { @class = "form-control", rows = "3" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-4">
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary">Submit Request</button>
                                        <a href="@Url.Action("Index", "Ecards")" class="btn btn-secondary ms-2">Back to List</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content-->
</main>

@section Scripts {
    <script>
        (function () {
            'use strict';
            var forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}