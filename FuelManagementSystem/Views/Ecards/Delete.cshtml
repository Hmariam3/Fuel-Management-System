@model FuelManagementSystem.Models.Ecard
@{
    ViewBag.Title = "Delete E-Card";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Delete E-Card</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Ecards")">E-Cards</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Delete</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-md-12">
                    <!--begin::Delete Card-->
                    <div class="card card-danger card-outline mb-4">
                        <div class="card-header">
                            <div class="card-title">Confirm Deletion</div>
                        </div>
                        <div class="card-body">
                            <h5>Are you sure you want to delete this e-card?</h5>
                            <dl class="row">
                                <dt class="col-sm-4">E-Card ID</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.EcardID)</dd>
                                <dt class="col-sm-4">Vehicle</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Vehicle.MakeAndType) (@Html.DisplayFor(model => model.PlateNo))</dd>
                                <dt class="col-sm-4">Balance (ETB)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Balance)</dd>
                                <dt class="col-sm-4">Status</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Status)</dd>
                                <dt class="col-sm-4">Activation Date</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.ActivationDateTime)</dd>
                            </dl>
                        </div>
                        <div class="card-footer">
                            @using (Html.BeginForm("Delete", "Ecards", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(model => model.EcardID)
                                <button type="submit" class="btn btn-danger me-2">Delete</button>
                                <a href="@Url.Action("Index", "Ecards")" class="btn btn-secondary">Cancel</a>
                            }
                        </div>
                    </div>
                    <!--end::Delete Card-->
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content-->
</main>