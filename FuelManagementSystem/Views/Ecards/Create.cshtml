@model FuelManagementSystem.Models.Ecard
@{
    ViewBag.Title = "Create New E-Card";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Ensure Select2 matches Bootstrap form-control */
    .select2-container--bootstrap-5 .select2-selection {
        height: calc(2rem + 2px);
        padding: 0rem 0.3rem;
        border: 1px solid #ced4da !important;
        border-radius: 0.375rem;
        font-size: 0.95rem;
    }

    .select2-container--bootstrap-5 .select2-selection__rendered {
        line-height: 2.2rem !important;
    }

    .select2-container--bootstrap-5 .select2-selection__arrow {
        height: 100% !important;
        top: 0.5rem !important;
    }

    .select2-results__options {
        max-height: 200px !important;
        overflow-y: auto !important;
    }

    .select2-container--bootstrap-5 .select2-selection__clear {
        position: absolute;
        right: 2.2rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1rem;
        color: #6c757d;
        cursor: pointer;
        opacity: 0.7;
    }

        .select2-container--bootstrap-5 .select2-selection__clear:hover {
            color: #dc3545;
            opacity: 1;
        }
</style>

<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Create New E-Card</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Ecards")">E-Cards</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Create</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-md-12">
                    <!--begin::Form Card-->
                    <div class="card card-success card-outline mb-4">
                        <div class="card-header">
                            <div class="card-title">E-Card Registration Form</div>
                        </div>
                        @using (Html.BeginForm("Create", "Ecards", FormMethod.Post, new { @class = "needs-validation", novalidate = true }))
                        {
                            @Html.AntiForgeryToken()
                        <div class="card-body">
                            <h5 class="mb-3">E-Card Details</h5>
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label for="EcardID" class="form-label">E-Card ID *</label>
                                    @Html.EditorFor(model => model.EcardID, new { htmlAttributes = new { @class = "form-control", required = true } })
                                    @Html.ValidationMessageFor(model => model.EcardID, "", new { @class = "invalid-feedback" })
                                </div>
                                <div class="col-md-4">
                                    <label for="CardType" class="form-label">Card Type *</label>
                                    @Html.DropDownListFor(model => model.CardType,
                                        new SelectList(new[] { "Normal", "Reserved" }),
                                        "Select Card Type",
                                        new { @class = "form-select select2", required = true })
                                    @Html.ValidationMessageFor(model => model.CardType, "", new { @class = "invalid-feedback" })
                                </div>
                                <div class="col-md-4" id="vehicleField">
                                    <label for="PlateNo" class="form-label">Vehicle *</label>
                                    @Html.DropDownListFor(model => model.PlateNo, ViewBag.PlateNo as SelectList, "Select Vehicle", new { @class = "form-select select2" })
                                    @Html.ValidationMessageFor(model => model.PlateNo, "", new { @class = "invalid-feedback" })
                                </div>
                                <div class="col-md-4" id="balanceField">
                                    <label for="Balance" class="form-label">Balance (ETB) *</label>
                                    @Html.EditorFor(model => model.Balance, new { htmlAttributes = new { @class = "form-control", type = "number", step = "0.01", min = "50000", max = "100000" } })
                                    @Html.ValidationMessageFor(model => model.Balance, "", new { @class = "invalid-feedback" })
                                </div>
                            </div>

                        </div>
                            <div class="card-footer">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
                                <button type="submit" class="btn btn-primary me-2">Create</button>
                                <a href="@Url.Action("Index", "Ecards")" class="btn btn-secondary">Cancel</a>
                            </div>
                        }
                    </div>
                    <!--end::Form Card-->
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content-->
</main>

@section scripts {
    <script src="~/plugins/select2/js/select2.full.min.js"></script>
    <script>
        $(document).ready(function () {
            // Initialize Select2
            $('.select2').select2({
                theme: 'bootstrap-5',
                placeholder: $(this).data('placeholder') || 'Select an option',
                allowClear: true,
                width: '100%'
            });


            function toggleFields() {
                const type = $('#CardType').val();
                if (type === "Reserved") {
                    $('#vehicleField').hide();
                    $('#balanceField').hide();
                } else {
                    $('#vehicleField').show();
                    $('#balanceField').show();
                }
            }
            $('#CardType').change(toggleFields);
            toggleFields(); // Initial call

            // Bootstrap 5 validation
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                    $('.select2').each(function () {
                        $(this).valid();
                    });
                }, false);
            });

            // Integrate jQuery validation with Select2
            $('.select2').on('select2:select select2:clear', function () {
                $(this).valid();
            });

            // Ensure Select2 borders are updated
            $('.select2').on('select2:open', function () {
                $(this).next('.select2-container').find('.select2-selection--single').addClass('form-select');
            });

            // Client-side validation for Balance
            $('#Balance').on('input', function () {
                const value = parseFloat($(this).val());
                if (isNaN(value) || value < 50000 || value > 100000) {
                    $(this).addClass('is-invalid');
                    $(this).next('.invalid-feedback').remove();
                    $(this).after('<div class="invalid-feedback">Balance must be either 50,000 and 100,000 ETB.</div>');
                } else {
                    $(this).removeClass('is-invalid');
                    $(this).next('.invalid-feedback').remove();
                }
            });
        });
    </script>
}