@model FuelManagementSystem.Models.Ecard

@{
    ViewBag.Title = "E-Card Details - ID " + Model?.EcardID;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">E-Card Details - ID @Model.EcardID</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Ecards")">E-Cards</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Details</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-md-12">
                    @if (Model == null)
                    {
                        <div class="card card-success card-outline mb-4">
                            <div class="card-body">
                                <div class="alert alert-danger">
                                    <p>Error: E-Card record not found.</p>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        try
                        {
                            <!-- E-Card Details -->
                            <div class="card card-success card-outline mb-4">
                                <div class="card-header">
                                    <div class="card-title">E-Card Information</div>
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <strong class="form-label">E-Card ID</strong>
                                            <p>@Model.EcardID</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Vehicle</strong>
                                            <p>@(Model.Vehicle?.MakeAndType ?? "N/A") (@(string.IsNullOrEmpty(Model.PlateNo) ? "N/A" : Model.PlateNo))</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Balance (ETB)</strong>
                                            <p>@Model.Balance</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Status</strong>
                                            <p>@(string.IsNullOrEmpty(Model.Status) ? "N/A" : Model.Status)</p>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="form-label">Activation Date</strong>
                                            <p>@(Model.ActivationDateTime.HasValue ? Model.ActivationDateTime.Value.ToString("yyyy-MM-dd HH:mm:ss") : "N/A")</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Replenishment Requests -->
                            <div class="card card-success card-outline mb-4">
                                <div class="card-header">
                                    <div class="card-title">Replenishment Requests</div>
                                </div>
                                <div class="card-body">
                                    @if (Model.EcardReplenishmentRequests != null && Model.EcardReplenishmentRequests.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-bordered table-striped" aria-label="E-Card replenishment requests">
                                                <thead>
                                                    <tr>
                                                        <th>Request ID</th>
                                                        <th>Requested Amount (ETB)</th>
                                                        <th>Request Date</th>
                                                        <th>Status</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var request in Model.EcardReplenishmentRequests)
                                                    {
                                                    <tr>
                                                        <td>@request.Id</td>
                                                        <td>@(request.RequestedAmount.HasValue ? request.RequestedAmount.Value.ToString("N2") : "N/A")</td>
                                                        <td>@(request.RequestedAt.HasValue ? request.RequestedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") : "N/A")</td>
                                                        <td>@(string.IsNullOrEmpty(request.Status) ? "N/A" : request.Status)</td>
                                                    </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">No replenishment requests for this E-Card.</p>
                                    }
                                </div>
                            </div>
                        }
                        catch (Exception ex)
                        {
                            <div class="card card-success card-outline mb-4">
                                <div class="card-body">
                                    <div class="alert alert-danger">
                                        <p>Error rendering E-Card details: @ex.Message</p>
                                    </div>
                                </div>
                            </div>
                            <script>
                                console.error('View rendering error:', '@ex.Message', '@ex.StackTrace');
                            </script>
                        }
                        <!-- Back Button -->
                        <div class="card card-success card-outline mb-4">
                            <div class="card-body">
                                <div class="d-flex justify-content-end">
                                    <a href="@Url.Action("Index", "Ecards")" class="btn btn-primary">Back to List</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content-->
</main>