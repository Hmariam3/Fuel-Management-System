@model IEnumerable<FuelManagementSystem.Models.Ecard>

@{
    ViewBag.Title = "E-Card Records";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">E-Card Records</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">E-Cards</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card card-success card-outline mb-4">
                        <div class="card-header">
                            <h3 class="card-title">E-Card List</h3>
                            <div class="card-tools">
                                <a href="@Url.Action("Create", "Ecards")" class="btn btn-primary btn-sm">Register New E-Card</a>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="ecardsTable" class="table table-bordered table-striped" aria-label="E-Card records">
                                    <thead>
                                        <tr>
                                            <th style="width: 10px">#</th>
                                            <th>E-Card ID</th>
                                            <th>Card Type</th>
                                            <th>Vehicle</th>
                                            <th>Balance (ETB)</th>
                                            <th>Status</th>
                                            <th>Activation Date</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.Any())
                                        {
                                            var index = 1;
                                            foreach (var item in Model)
                                            {
                                        <tr class="align-middle">
                                            <td>@index</td>
                                            <td>@(string.IsNullOrEmpty(item.EcardID) ? "N/A" : item.EcardID)</td>
                                            <td>@item.CardType</td>
                                            <td>@(item.Vehicle?.MakeAndType ?? "N/A") (@(string.IsNullOrEmpty(item.PlateNo) ? "N/A" : item.PlateNo))</td>
                                            <td>@item.Balance</td>
                                            <td>@(string.IsNullOrEmpty(item.Status) ? "N/A" : item.Status)</td>
                                            <td>@(item.ActivationDateTime.HasValue ? item.ActivationDateTime.Value.ToString("yyyy-MM-dd HH:mm:ss") : "N/A")</td>
                                            <td>
                                                <!-- Details always first -->
                                                <a href="@Url.Action("Details", new { id = item.EcardID })"
                                                   class="btn btn-sm btn-info text-white me-1" title="Details">
                                                    <i class="bi bi-eye"></i>
                                                </a>

                                                @* Normal Cards *@
                                                @if (item.CardType == "Normal")
                                                {
                                                    if (item.Status == "Lost")
                                                    {
                                                        <!-- Restore Lost Card -->
                                                        using (Html.BeginForm("RestoreLostCard", "Ecards", FormMethod.Post, new { @style = "display:inline;" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            @Html.Hidden("ecardId", item.EcardID)
                                                            <button type="submit" class="btn btn-sm btn-success me-1" title="Restore Lost Card">
                                                                <i class="bi bi-arrow-repeat"></i>
                                                            </button>
                                                        }
                                                    }
                                                    else if (item.Status == "Active")
                                                    {
                                                        <!-- Mark as Lost -->
                                                        using (Html.BeginForm("MarkAsLost", "Ecards", FormMethod.Post, new { @style = "display:inline;" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            @Html.Hidden("ecardId", item.EcardID)
                                                            <button type="submit" class="btn btn-sm btn-dark me-1" title="Mark as Lost">
                                                                <i class="bi bi-exclamation-triangle"></i>
                                                            </button>
                                                        }

                                                        <!-- Normal Edit/Delete -->
                                                        <a href="@Url.Action("Edit", new { id = item.EcardID })"
                                                           class="btn btn-sm btn-warning text-white me-1" title="Edit">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </a>
                                                        <a href="@Url.Action("Delete", new { id = item.EcardID })"
                                                           class="btn btn-sm btn-danger" title="Delete">
                                                            <i class="bi bi-trash"></i>
                                                        </a>
                                                    }
                                                }

                                                @* Reserved Cards *@
                                                else if (item.CardType == "Reserved")
                                                {
                                                    if (string.IsNullOrEmpty(item.PlateNo))
                                                    {
                                                        <!-- Assign Reserved -->
                                                        <a href="@Url.Action("AssignReservedCard", new { ecardid = item.EcardID })"
                                                           class="btn btn-sm btn-success me-1" title="Assign Reserved Card">
                                                            <i class="bi bi-link-45deg"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <!-- Release Reserved -->
                                                        using (Html.BeginForm("ReleaseReservedCard", "Ecards", FormMethod.Post, new { @style = "display:inline;" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            @Html.Hidden("ecardId", item.EcardID)
                                                            <button type="submit" class="btn btn-sm btn-danger me-1" title="Release Reserved Card">
                                                                <i class="bi bi-arrow-left-circle"></i>
                                                            </button>
                                                        }
                                                    }
                                                }
                                            </td>


                                        </tr>
                                                index++;
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center">No E-Card records found.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content-->
</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#ecardsTable').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                lengthMenu: [5, 10, 25, 50, 100],
                pageLength: 10,
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search records...",
                    paginate: {
                        previous: "&laquo;",
                        next: "&raquo;"
                    }
                },
                columnDefs: [
                    { orderable: false, targets: [0, -1] }
                ],
                dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });
        });
    </script>
}